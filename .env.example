# ─── Firebase Firestore (database) ───
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ─── Firebase Client SDK (Google Sign-in / OTP / Storage) ───
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app

# ─── Google OAuth (for Gmail login button) ───
# Get from console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxx

# ─── Cloudinary (image storage) ───
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ─── NextAuth ───
NEXTAUTH_URL=https://your-app.vercel.app
NEXTAUTH_SECRET=your-random-secret-here

# ─── Razorpay ───
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret
# Set this in the Razorpay Dashboard → Settings → Webhooks, pointed at
# https://<domain>/api/payments/webhook, subscribed to "payment.captured".
# This is a different secret from RAZORPAY_KEY_SECRET above.
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# ─── Admin emails (comma separated, these get admin role automatically) ───
ADMIN_EMAILS=admin@tulsibridal.com,youremail@gmail.com

# ─── Shiprocket (optional — enables courier booking + COD pincode checks) ───
SHIPROCKET_EMAIL=your-shiprocket-login-email
SHIPROCKET_PASSWORD=your-shiprocket-password
# Pincode of the address Shiprocket picks up from (Settings → Pickup Addresses)
SHIPROCKET_PICKUP_PINCODE=600001
# Exact "nickname" of that pickup address in Shiprocket (not whether it's
# marked PRIMARY there) — defaults to "Primary" if unset
SHIPROCKET_PICKUP_LOCATION=Primary
