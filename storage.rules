rules_version = '2';

// Product images are uploaded to Cloudinary via /api/upload; the client-side
// Firebase Storage helper (src/lib/firebaseStorage.js) is not imported
// anywhere. Server code uses the Admin SDK, which bypasses these rules.
// Deploy: firebase deploy --only storage
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
